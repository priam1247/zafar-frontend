# Cloudflare serves these as-is. Pages are never cached: a phone must see the
# current app on the next visit, not one from last week.
/*.html
  Cache-Control: no-cache

# The app is never framed, never runs anything it did not ship, and never lets
# a browser guess a file's type. (No script-src: every page carries a small
# inline script, so a strict policy would need nonces served per request.)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'

# The icons are static and their names are stable. A day of caching keeps the
# tab strip and the install prompt quick without freezing a changed mark for
# weeks; the PNGs and the SVG share one age so they never disagree.
/favicon.ico
  Cache-Control: public, max-age=86400

/assets/img/*
  Cache-Control: public, max-age=86400

# The admin portal is a tool. It is noindex in its own <meta> and closed in
# robots.txt; this is the third lock, for anything that asks with a header.
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
